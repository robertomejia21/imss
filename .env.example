# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor (webhooks, formulario público). NUNCA exponer en el cliente.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Anthropic (agente IA + OCR) ----------
ANTHROPIC_API_KEY=
# Modelo del agente. claude-opus-5-5 (más capaz) o claude-sonnet-5-5 (más económico)
ANTHROPIC_MODEL=claude-opus-5-5

# ---------- Green API (WhatsApp) ----------
GREEN_API_URL=https://api.green-api.com
GREEN_API_MEDIA_URL=https://media.green-api.com
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN_INSTANCE=
# Token que configuras en Green API como "webhookUrlToken"; llega como "Authorization: Bearer <token>"
GREEN_API_WEBHOOK_TOKEN=
# Número de WhatsApp del negocio (solo dígitos, con lada país) para el botón del formulario
NEXT_PUBLIC_WHATSAPP_NUMBER=5215500000000

# ---------- Transcripción de audios (OpenAI) ----------
# Claude no recibe audio directamente; las notas de voz se transcriben con OpenAI.
OPENAI_API_KEY=
# Opcional: OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe (o gpt-4o-transcribe, más preciso y caro)

# ---------- Integraciones externas (Zapier/Make/Meta Lead Ads → POST /api/leads) ----------
INTAKE_API_KEY=

# URL pública de la app (para links y webhooks)
NEXT_PUBLIC_APP_URL=http://localhost:3000
